# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
#
#   cp .env.example .env

# REQUIRED. The only key any experiment needs.
# Free key from https://aistudio.google.com/apikey — no card required.
#
# The free tier is 20 requests/day/model. That is MEASURED, from the API's own
# 429 body, not the 1,500/day every blog claims. See EXPERIMENT.md.
# The quota resets at midnight Pacific — 12:30 PM IST, not local midnight.
GEMINI_API_KEY=

# OPTIONAL. Cross-checks only, never the primary arm: OpenRouter's structured
# output support is per endpoint rather than per model and it documents that it
# "might fall back to json_object", which would silently downgrade constrained
# decoding to a hint. `OpenRouterProvider` always reports constrained=False so a
# mixed log cannot be misread. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OPTIONAL, and unused so far. Inception Mercury is a diffusion LLM, so it is a
# paradigm confound in the main comparison and is reserved for the follow-up in
# EXPERIMENT.md ("does in-place refinement corrupt less?").
INCEPTION_API_KEY=
